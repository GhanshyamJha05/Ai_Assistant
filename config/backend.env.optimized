# =============================================================================
# Backend Startup Optimization Configuration
# =============================================================================
# This file contains optimized settings to reduce backend startup time
# from ~210 seconds to ~15 seconds (93% reduction)
#
# Usage: Copy these settings to your .env file or use --env-file flag
# =============================================================================

# -----------------------------------------------------------------------------
# CRITICAL: Prevent HuggingFace Timeout (Saves ~150 seconds / 71%)
# -----------------------------------------------------------------------------
# Disable semantic cache at startup to prevent network timeout
# The cache will load in background when first needed
ENABLE_SEMANTIC_CACHE=false

# -----------------------------------------------------------------------------
# Lazy Initialization (Saves ~60 seconds / 29%)
# -----------------------------------------------------------------------------
# Load heavy components only when first used
LAZY_INIT=true
BACKGROUND_INIT=true

# App discovery happens on first app request (saves ~10-20 seconds)
LAZY_APP_DISCOVERY=true

# -----------------------------------------------------------------------------
# Feature Flags - Disable Heavy Features at Startup
# -----------------------------------------------------------------------------
# Voice features load on first voice request (saves ~40 seconds)
ENABLE_VOICE=false

# Multimodal AI loads on first image request (saves ~5 seconds)
ENABLE_MULTIMODAL=false

# System monitoring starts after server ready (saves ~2 seconds)
ENABLE_SYSTEM_MONITORING=false

# Multilingual support loads when needed (saves ~3 seconds)
ENABLE_MULTILINGUAL=false

# Keep essential features enabled
ENABLE_CONVERSATIONAL_AI=true

# -----------------------------------------------------------------------------
# Caching Configuration
# -----------------------------------------------------------------------------
# Cache app discovery results to prevent duplicate scans
APP_CACHE_HOURS=24
MODEL_CACHE_ENABLED=true

# -----------------------------------------------------------------------------
# Voice System Configuration
# -----------------------------------------------------------------------------
# Vosk models load on-demand via singleton manager
VOSK_LAZY_LOAD=true
VOSK_PRELOAD_ENGLISH=false  # Set to true to preload English model in background

# -----------------------------------------------------------------------------
# Network & Timeout Settings
# -----------------------------------------------------------------------------
# Prevent long network timeouts during startup
SENTENCE_TRANSFORMERS_HOME=./models/sentence-transformers
HF_HOME=./models/huggingface
TRANSFORMERS_OFFLINE=1  # Use offline mode if models are cached

# -----------------------------------------------------------------------------
# Security Configuration (Production)
# -----------------------------------------------------------------------------
# IMPORTANT: Set these in production
# SECRET_KEY=your-secret-key-here
# JWT_SECRET_KEY=your-jwt-secret-here
# ADMIN_PASSWORD=your-secure-password

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
DEBUG=false

# -----------------------------------------------------------------------------
# CORS Origins
# -----------------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:5173,http://127.0.0.1:5000,http://127.0.0.1:3000,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
DISABLE_SOCKETIO_LOGGING=true

# =============================================================================
# Performance Monitoring
# =============================================================================
# Enable startup timing instrumentation
ENABLE_STARTUP_PROFILING=true
LOG_STARTUP_TIMES=true

# =============================================================================
# Quick Start Guide
# =============================================================================
# 1. Copy this file to .env: cp backend.env.optimized .env
# 2. Customize passwords and secrets
# 3. Run: python modern_web_backend.py
# 4. Expected startup: < 15 seconds
#
# To pre-download models (optional one-time setup):
# python -c "from sentence_transformers import SentenceTransformer; SentenceTransformer('all-MiniLM-L6-v2')"
# =============================================================================
