  "shortcuts": [
    {
      "name": "Voice Command",
      "short_name": "Voice",
      "description": "Start voice conversation",
      "url": "/?mode=voice",
      "icons": [{ "src": "/static/icons/voice.png", "sizes": "192x192" }]
    },
    {
      "name": "Chat",
      "short_name": "Chat",
      "description": "Open text chat",
      "url": "/?mode=chat",
      "icons": [{ "src": "/static/icons/chat.png", "sizes": "192x192" }]
    },
    {
      "name": "Automation",
      "short_name": "Automate",
      "description": "Quick automation tasks",
      "url": "/?mode=automation",
      "icons": [{ "src": "/static/icons/automation.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
