# YourDaddy AI Assistant - Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# =============================================================================
# AI API Keys
# =============================================================================
# Get your Gemini API key from: https://aistudio.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your_gemini_api_key_here

# Get your OpenAI API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Project ID (for Cloud Speech-to-Text, etc.)
GOOGLE_CLOUD_PROJECT_ID=your_project_id_here

# =============================================================================
# Database & Security
# =============================================================================
# Encryption key for sensitive data in databases (generate with: openssl rand -hex 32)
DATABASE_ENCRYPTION_KEY=

# Flask secret key (generate with: openssl rand -hex 32)
SECRET_KEY=

# JWT secret key for token authentication (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=

# PIN encryption key (generate with: openssl rand -hex 32)
PIN_ENCRYPTION_KEY=

# Session secret key (generate with: openssl rand -hex 32)
SESSION_SECRET_KEY=

# Admin password for web backend (set a strong password)
ADMIN_PASSWORD=

# =============================================================================
# Feature Flags
# =============================================================================
# Enable external voice APIs (OpenAI Whisper, Google Cloud Speech)
# Set to 'false' to use only offline voice recognition
ENABLE_VOICE_EXTERNAL_APIS=true

# Enable file deletion through AI commands
# Set to 'false' for safety
ENABLE_FILE_DELETION=false

# Enable application execution through AI commands
ENABLE_APP_EXECUTION=true

# Enable mult imodal AI features (image/video processing)
ENABLE_MULTIMODAL=true

# Enable voice features
ENABLE_VOICE=true

# =============================================================================
# API Rate Limits
# =============================================================================
# General API request limit per minute
API_RATE_LIMIT_PER_MINUTE=60

# Voice API request limit per minute (lower to save costs)
VOICE_API_RATE_LIMIT_PER_MINUTE=10

# =============================================================================
# Backend Configuration
# =============================================================================
# Port for the backend server
BACKEND_PORT=5000

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# =============================================================================
# Paths (relative to project root)
# =============================================================================
DATA_DIR=data
LOGS_DIR=logs
DATABASES_DIR=databases

# =============================================================================
# Optional: External Services
# =============================================================================
# Spotify API credentials (for music control)
# SPOTIFY_CLIENT_ID=your_client_id
# SPOTIFY_CLIENT_SECRET=your_client_secret

# Calendar API credentials
# GOOGLE_CALENDAR_CREDENTIALS_FILE=path/to/credentials.json
