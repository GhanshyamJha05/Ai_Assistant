# =============================================================================
# STARTUP OPTIMIZATION - Feature Toggles
# =============================================================================
# Control which features are enabled at startup to optimize loading time.
# Set to 'false' to disable optional features and reduce startup time.

# Lazy initialization - load components only when first used (recommended)
LAZY_INIT=true

# Background initialization - start server immediately, init components in background (recommended)
BACKGROUND_INIT=true

# Enable voice recognition and text-to-speech features
ENABLE_VOICE=true

# Enable multimodal AI (vision/image processing)
ENABLE_MULTIMODAL=true

# Enable advanced conversational AI
ENABLE_CONVERSATIONAL_AI=true

# Enable system monitoring (CPU, memory, network stats)
ENABLE_SYSTEM_MONITORING=true

# =============================================================================
# SECURITY
# =============================================================================
# Set a strong admin password for production use
ADMIN_PASSWORD=changeme123

# JWT secret keys (auto-generated if not set)
SECRET_KEY=
JWT_SECRET_KEY=

# =============================================================================
# API KEYS
# =============================================================================
# Gemini API key for multimodal AI features
GEMINI_API_KEY=

# Porcupine access key for wake word detection
PORCUPINE_ACCESS_KEY=

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
# Host and port for the backend server
HOST=127.0.0.1
PORT=5000

# Allowed CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://127.0.0.1:3000,http://127.0.0.1:5000,http://localhost:5173,http://127.0.0.1:5173
